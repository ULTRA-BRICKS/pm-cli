#!/usr/bin/env python3
# Thin shim for the symlink install path (install.sh symlinks this into a bin dir; the symlink
# must resolve back to the repo to find the pmlib package). pipx / package installs use
# [project.scripts] pm = "pmlib.cli:main" and never run this file. Keep it MINIMAL.
import os
import sys

# Follow the symlink to the real repo root and add it to sys.path ONLY when the sibling package
# is actually present there — never blindly, never the cwd (pm runs in foreign repos).
_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isfile(os.path.join(_root, "pmlib", "__init__.py")):
    sys.path.insert(0, _root)

from pmlib.cli import main  # noqa: E402

raise SystemExit(main())
